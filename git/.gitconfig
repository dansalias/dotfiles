# ln ~/.gitconfig

[alias]
  s = status
  a = add
  c = commit
  d = diff

[core]
  editor = helix

[credential]
  helper = store

[init]
  defaultBranch = trunk

[pull]
  rebase = true

[push]
  default = simple

[remote "origin"]
  receivepack = git-receive-pack

[user]
  name = dansalias
  email = danyoungnz@gmail.com

[filter "lfs"]
  required = true
  process = git-lfs filter-process
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
